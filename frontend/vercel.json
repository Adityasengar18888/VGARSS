{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/vgarss/api/(.*)",
      "destination": "https://vgarss.onrender.com/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://vgarss.onrender.com/api/$1"
    },
    {
      "source": "/vgarss/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/vgarss/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|webmanifest|woff|woff2))",
      "destination": "/$1"
    },
    {
      "source": "/vgarss/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vgarss/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
