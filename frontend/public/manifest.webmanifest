{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "./",
  "name": "VGARSS",
  "short_name": "VGARSS",
  "description": "Virtual Group Asynchronous Real-Time Resource Synchronization & Scheduling System",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F5F6F8",
  "theme_color": "#4055A8",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Conversations & Chat",
      "short_name": "Chat",
      "description": "Open VGARSS real-time chat and workspace channels",
      "url": "/",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Process Scheduler",
      "short_name": "Scheduler",
      "description": "Interactive OS process scheduling and Gantt telemetry",
      "url": "/?view=scheduler",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Computer Networks Lab",
      "short_name": "Networks",
      "description": "Socket framing and WebSocket telemetry monitor",
      "url": "/?view=network",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ]
}

