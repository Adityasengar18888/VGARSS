# ==========================================
# VGARSS - Environment Configuration Template
# Copy to .env for local configuration
# ==========================================

# Backend Configuration
VGARSS_ENV=development
VGARSS_HOST=127.0.0.1
VGARSS_PORT=8000
VGARSS_TCP_PORT=9000
VGARSS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VGARSS_DATABASE_URL=sqlite:///./vgarss.db
VGARSS_SECRET_KEY=vgarss-development-insecure-secret-key-change-in-prod
VGARSS_LOG_LEVEL=INFO

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE="VGARSS - Virtual Group Asynchronous Real-Time Resource Synchronization & Scheduling"
