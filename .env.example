# ==============================================================================
# VGARSS 2.0 — Production & Multi-Device Environment Configuration Template
# ------------------------------------------------------------------------------
# Security Notice:
# 1. Never commit real credentials, database passwords, or secret keys to Git.
# 2. In production, copy this template to .env or configure directly in your
#    hosting environment (Docker, Kubernetes, Render, Railway, Fly.io, AWS, etc.).
# ==============================================================================

# --- Application & Hosting Environment ---
VGARSS_ENV=production
VGARSS_HOST=0.0.0.0
PORT=8000
VGARSS_LOG_LEVEL=INFO

# --- Security & Session Authentication ---
# Generate a cryptographically strong 256-bit key for production:
# e.g., openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
VGARSS_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# --- CORS & Reverse Proxy Trusted Origins ---
# Comma-separated list of explicit trusted origins allowed to access the REST and WebSocket APIs.
# NEVER use "*" with credentials enabled in production.
VGARSS_CORS_ORIGINS=https://vgarss.example.com,https://app.vgarss.io,http://localhost:5173
VGARSS_TRUST_PROXY_HEADERS=true

# --- Database Persistence (PostgreSQL for Shared Multi-Device State) ---
# For Production PostgreSQL:
DATABASE_URL=postgresql://vgarss_user:SecurePassword123!@db-host.internal:5432/vgarss_production
# For Local Zero-Setup SQLite:
# DATABASE_URL=sqlite:///./vgarss.db

# --- Authoritative Server-Side Scheduler Worker & Distributed Coordination ---
WORKER_ID=worker-app-node-01
VGARSS_SCHEDULER_WORKER=true
VGARSS_SCHEDULER_INTERVAL=1.0
VGARSS_SCHEDULER_LOCK_TTL=5.0

# --- WebSockets & Multi-Device Telemetry ---
VGARSS_WS_MAX_QUEUE=150
VGARSS_WS_HISTORY_SIZE=500
VGARSS_WS_TIMEOUT=5.0

# --- Coursework Raw TCP Socket Server (Isolated on Port 9000) ---
# Kept completely separate from public web traffic. In public web deployments,
# set to false and run standalone via: python scripts/run_tcp_server.py
VGARSS_ENABLE_TCP=false
VGARSS_TCP_PORT=9000
VGARSS_TCP_MAX_CONN=50
VGARSS_TCP_TIMEOUT=30.0
VGARSS_TCP_MAX_FRAME=1048576

# --- Frontend Client Build Environment (Vite) ---
# Used during `npm run build` or runtime browser container injection.
# Leave blank to auto-detect window.location.origin (HTTPS -> WSS)
VITE_API_URL=https://vgarss.example.com
VITE_WS_URL=wss://vgarss.example.com
